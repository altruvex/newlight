{
  "name": "newlight-v2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "turbo clean && rm -rf node_modules",
    "lint": "node scripts/assert-turbo-tasks.mjs lint 4 && turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "node scripts/assert-turbo-tasks.mjs check-types 4 && node scripts/assert-type-budget.mjs",
    "check-types:full": "node scripts/assert-turbo-tasks.mjs check-types 4 && turbo run check-types",
    "test": "node scripts/assert-turbo-tasks.mjs test 4 && turbo run test"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=20.19"
  }
}
