{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "CLOUDINARY_CLOUD_NAME",
        "CRON_SECRET",
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "EMAIL_FROM",
        "EMAIL_REPLY_TO",
        "INVENTORY_SWEEP_CRON_SECRET",
        "LOG_LEVEL",
        "MAIL_OUTBOX_CRON_SECRET",
        "NEXT_PUBLIC_*",
        "PUSH_SWEEP_CRON_SECRET",
        "RESEND_API_KEY",
        "RESEND_BASE_URL",
        "RESEND_MIN_INTERVAL_MS",
        "STOREFRONT_REVALIDATION_SECRET",
        "STOREFRONT_REVALIDATION_URL",
        "STOREFRONT_URL",
        "VAPID_PRIVATE_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_SUBJECT",
        "VERCEL_ENV",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "VERCEL_BRANCH_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "eslint.config.*",
        ".eslintrc*"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "test/**"
      ],
      "cache": false,
      "env": [
        "TEST_DATABASE_URL"
      ]
    }
  }
}
